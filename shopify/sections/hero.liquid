{%- comment -%}
  Home hero — ported from the static site's <section class="hero">.
  Use this as the pattern for porting the other content sections
  (welcome / features / rooms / gallery-strip / testimonials / cta-band).
{%- endcomment -%}
<section class="hero">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      <img
        src="{{ section.settings.image | image_url: width: 1600 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
        sizes="100vw"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        alt="{{ section.settings.image.alt | escape }}"
        fetchpriority="high">
    </div>
  {%- endif -%}

  <div class="container hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow is-light">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1>{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.tagline != blank -%}
      <p class="hero__tagline">{{ section.settings.tagline }}</p>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="rte">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="hero__actions">
        {%- for block in section.blocks -%}
          {%- if block.type == 'button' and block.settings.url != blank -%}
            <a class="btn {{ block.settings.style }}" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.scroll_anchor != blank -%}
    <a class="hero__scroll" href="#{{ section.settings.scroll_anchor }}" aria-label="Scroll to content">
      {% render 'icon', name: 'chevron-down' %}
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wayanad · Kerala" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A quiet homestay in the folds of Wayanad" },
    { "type": "text", "id": "tagline", "label": "Tagline line", "default": "Every travel is a catharsis." },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "scroll_anchor", "label": "Scroll-down target section id", "default": "welcome" }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Check availability" },
        { "type": "url", "id": "url", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "default": "btn--primary",
          "options": [
            { "value": "btn--primary", "label": "Primary (clay)" },
            { "value": "btn--on-dark", "label": "Outline on dark" },
            { "value": "btn--wa", "label": "WhatsApp green" }
          ]
        }
      ]
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
