{%- liquid
  assign wa = settings.wa_number
-%}
<footer class="site-footer">
  <div class="container footer-grid">

    <div class="footer-col footer-brand">
      {% render 'brand-mark', class: 'footer-brand__mark' %}
      <div class="footer-brand__name">{{ settings.brand_name | default: shop.name }}</div>
      {%- if settings.brand_tagline != blank -%}
        <p class="footer-brand__tag">{{ settings.brand_tagline }}</p>
      {%- endif -%}
      <div class="footer-socials">
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}</a>
        {%- endif -%}
        {%- if settings.social_facebook != blank -%}
          <a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">{% render 'icon', name: 'facebook' %}</a>
        {%- endif -%}
        {%- if wa != blank -%}
          <a href="#" data-wa="Hello {{ shop.name }}!" aria-label="WhatsApp">{% render 'icon', name: 'whatsapp' %}</a>
        {%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'menu' -%}
        <div class="footer-col" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          <ul>
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- elsif block.type == 'contact' -%}
        <div class="footer-col" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading | default: 'Reach us' }}</h4>
          <ul>
            {%- if settings.address_text != blank -%}
              <li class="with-icon">{% render 'icon', name: 'pin' %}
                {%- if settings.map_url != blank -%}
                  <a href="{{ settings.map_url }}" target="_blank" rel="noopener">{{ settings.address_text | newline_to_br }}</a>
                {%- else -%}
                  <span>{{ settings.address_text | newline_to_br }}</span>
                {%- endif -%}
              </li>
            {%- endif -%}
            {%- if settings.phone_display != blank -%}
              <li class="with-icon">{% render 'icon', name: 'phone' %}<a href="#" data-tel data-tel-text>{{ settings.phone_display }}</a></li>
            {%- endif -%}
            {%- if settings.contact_email != blank -%}
              <li class="with-icon">{% render 'icon', name: 'mail' %}<a href="#" data-email data-email-text>{{ settings.contact_email }}</a></li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endfor -%}

  </div>

  <div class="container footer-bottom">
    <span>&copy; <span id="year">{{ 'now' | date: '%Y' }}</span> {{ shop.name }}. All rights reserved.</span>
    <span>{{ section.settings.tagline_right | default: 'Wayanad, Kerala · Homestay' }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline_right", "label": "Bottom-right text", "default": "Wayanad, Kerala · Homestay" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact column",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Reach us" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Explore" } },
      { "type": "menu", "settings": { "heading": "Book" } },
      { "type": "contact" }
    ]
  }
}
{% endschema %}
