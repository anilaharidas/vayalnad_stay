{%- comment -%}
  Inline SVG icons used by the header, footer and shared sections.
  Usage: {% render 'icon', name: 'phone' %}
         {% render 'icon', name: 'whatsapp-solid', class: 'icon icon--lg' %}
{%- endcomment -%}
{%- liquid
  assign cls = class | default: 'icon'
-%}
{%- case name -%}
  {%- when 'phone' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.09 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
  {%- when 'mail' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/><path d="m22 6-10 7L2 6"/></svg>
  {%- when 'pin' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
  {%- when 'instagram' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
  {%- when 'facebook' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
  {%- when 'whatsapp' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15l-1.4 5 5.1-1.3A10 10 0 1 0 12 2Z"/></svg>
  {%- when 'whatsapp-solid' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15l-1.4 5 5.1-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 0 1 6.3 12.9l.9 3-3-.8A8 8 0 1 1 12 4Z"/><path d="M8.5 7.7c-.2-.5-.4-.5-.6-.5h-.5a1 1 0 0 0-.7.3c-.3.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.9 4.5 4 2.2.9 2.7.7 3.2.7.5-.1 1.6-.7 1.9-1.3.2-.7.2-1.2.1-1.3l-.5-.3-1.9-.9c-.3-.1-.5-.1-.7.1l-.7.9c-.1.2-.3.2-.5.1a6.3 6.3 0 0 1-1.9-1.1 7 7 0 0 1-1.3-1.6c-.1-.2 0-.4.1-.5l.4-.5c.2-.1.2-.3.3-.5v-.4L8.5 7.7Z" fill="currentColor"/></svg>
  {%- when 'menu' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
  {%- when 'close' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg>
  {%- when 'chevron-right' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
  {%- when 'arrow-right' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
{%- endcase -%}
