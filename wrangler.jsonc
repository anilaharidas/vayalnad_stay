{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vayalnad-stay",
  "main": "worker.js",
  "compatibility_date": "2026-09-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/img/*.mp4"]
  }
}
