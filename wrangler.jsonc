{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vayalnad-stay",
  "main": "worker.js",
  "compatibility_date": "2026-09-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/img/*.mp4", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vayalnad-feedback",
      "database_id": "a16df237-a7ca-4c58-b3a9-727475e34392"
    }
  ]
}
